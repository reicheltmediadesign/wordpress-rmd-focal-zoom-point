#: includes/Admin/MediaField.php:122
#: build/editor.js:1
msgid "Focal point & zoom"
msgstr "Bildausschnitt & Zoom"

#. translators: 1: required PHP version, 2: current PHP version
#: rmd-focal-zoom-point.php:38
#, php-format
msgid "RMD Focal Zoom Point requires PHP %1$s or newer. This site runs PHP %2$s, so the plugin stays inactive."
msgstr "RMD Focal Zoom Point benötigt PHP %1$s oder neuer. Diese Website läuft mit PHP %2$s, daher bleibt das Plugin inaktiv."

#: build/editor.js:1
msgid "The focal point could not be saved to the image:"
msgstr "Der Bildausschnitt konnte nicht am Bild gespeichert werden:"

#: build/editor.js:1
msgid "You are not allowed to change this image. You can still adjust it for this block only."
msgstr "Sie dürfen dieses Bild nicht ändern. Sie können es aber nur für diesen Block anpassen."

#: build/editor.js:1
msgid "Enlarges the image around the focal point. Also lets you move the focus sideways in a tall image shown in a square or circle."
msgstr "Vergrößert das Bild um den Fokuspunkt. So lässt sich der Ausschnitt auch bei einem Hochformat im Quadrat oder Kreis seitlich verschieben."

#: build/editor.js:1
msgid "Adjust for this block only"
msgstr "Nur für diesen Block anpassen"

#: build/editor.js:1
msgid "These values apply only here. The image keeps its own values elsewhere."
msgstr "Diese Werte gelten nur hier. An anderen Stellen behält das Bild seine eigenen Werte."

#: build/editor.js:1
msgid "Changes are saved to the image right away and apply wherever it is used."
msgstr "Änderungen werden sofort am Bild gespeichert und gelten überall, wo es verwendet wird."
